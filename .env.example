# ─── MCP Transport ────────────────────────────────────────────────────────────
# "stdio"           — local subprocess (Claude Desktop / Claude Code / Zed)
# "streamable-http" — remote HTTP server (containers, cloud deploys)
#
# On a cloud host you usually leave this as stdio: app.py automatically
# switches to HTTP when the host sets PORT. (On Databricks, app.yaml copies
# DATABRICKS_APP_PORT into PORT.)
MCP_TRANSPORT=stdio

# ─── HTTP Server (only used when running over HTTP) ───────────────────────────
# 127.0.0.1 = this computer only. Hosts that set PORT ignore these.
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Local browser pages allowed to call the server (CORS), comma-separated.
# Only http://127.0.0.1:<port> or http://localhost:<port> are accepted.
# Leave empty unless a browser page on this computer needs to call the server.
MCP_CORS_ORIGINS=
# MCP_CORS_ORIGINS=http://127.0.0.1:5500

# ─── Data Source ──────────────────────────────────────────────────────────────
# BLM public mining claims map service. Leave commented out to use the default
# in src/mining_claims_mcp/config.py. Keep the trailing slash.
#
# BLM_MINING_CLAIMS_URL=https://nlsdbpubgis.blm.gov/arcgis/rest/services/Mining_Claims/MiningClaims/MapServer/
#
# Fewest claims the BLM service should hold (layer 0). Below this, a search
# that finds nothing reports that the service looks incomplete (e.g. while
# BLM reloads its data) instead of "not found". Lower it only if BLM's real
# total drops below the default.
# BLM_MIN_TOTAL_RECORDS=4000000
#
# USGS Geographic Names (GNIS) map service, for looking up place names.
# USGS_GEONAMES_URL=https://carto.nationalmap.gov/arcgis/rest/services/geonames/MapServer/

# ─── Dataset API Keys ─────────────────────────────────────────────────────────
# Add a variable for each federal API your tools call, and a matching typed
# field in src/mining_claims_mcp/config.py. Never commit the filled-in .env.
#
# EXAMPLE_API_KEY=your_key_here
